# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=true
separator_block_width=15

# [documentation]
# full_text=Documentation
# website=https://vivien.github.io/i3blocks
# command=xdg-open "$website"
# color=#f12711

# [greetings]
# color=#f5af19
# command=echo "$(whoami)@$(hostname)"
# interval=once

[gammastep]
command=pgrep -x gammastep > /dev/null && echo "" || echo ""
interval=5
signal=10
color=pgrep -x gammastep > /dev/null && echo "#FFD700" || echo "#666666"

[cpu_usage]
label= CPU:
command=top -bn2 | grep "Cpu(s)" | tail -n 1 | awk '{print 100 - $8"%"}'
interval=5

[cpu_temp]
label= SENSOR:
command=sensors|grep -i 'CPUTIN'|awk '{print $2}'
interval=5

[memory]
label= MEM:
command=free -h | awk '/^Mem/ {print $3 "/" $2}'
interval=5

# [mem_temp]
# label= MEM:
# command=sensors | grep -i 'DIMM' | awk '{print $2}'
# interval=5

# [gpu_temp]
# label= GPU:
# command=nvidia-smi -q -d TEMPERATURE | grep "GPU Current Temp"| awk -F: '{print $NF}'
# interval=5

[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1

[network]
command=nmcli -t -f DEVICE,STATE dev | grep -q "enp37s0:connected" && echo "" || (nmcli -t -f WIFI g | grep -q "enabled" && echo "" || echo "睊")
interval=5
color=nmcli -t -f DEVICE,STATE dev | grep -q "enp37s0:connected" && echo "#00FF00" || (nmcli -t -f WIFI g | grep -q "enabled" && echo "#00FF00" || echo "#FF0000")

